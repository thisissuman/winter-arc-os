      "css": ".ds-button-destructive{display:inline-flex;align-items:center;justify-content:center;min-height:44px;box-sizing:border-box;padding:0 12px;gap:8px;border:1px solid transparent;border-radius:8px;font-size:14px;line-height:21px;font-weight:500;cursor:pointer;font-family:var(--font-geist-sans,Geist,sans-serif);transition:background-color 150ms cubic-bezier(0,0,.2,1),color 150ms cubic-bezier(0,0,.2,1),border-color 150ms cubic-bezier(0,0,.2,1);background:color-mix(in srgb,var(--destructive,#ffb4ab) 20%,transparent);color:var(--destructive,#ffb4ab);}.ds-button-destructive:hover{background:color-mix(in srgb,var(--destructive,#ffb4ab) 30%,transparent);}.ds-button-destructive:focus-visible{border-color:var(--ring,#a89af3);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#a89af3) 50%,transparent);outline:none;}.ds-button-destructive:active{transform:translateY(1px)}.ds-button-destructive:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-destructive{transition:none}}"
