    {
      "name": "Habit Name Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Visible label, strong field stroke and task-sized text on a phone.",
      "html": "<label class=\"ds-field-label\" for=\"ds-habit-name\">Habit name</label><input class=\"ds-field\" id=\"ds-habit-name\" placeholder=\"e.g. Read\" maxlength=\"80\">",
      "css": ".ds-field-label{display:block;margin-bottom:8px;color:var(--foreground,#ededf2);font-size:14px;line-height:20px;font-weight:500;font-family:var(--font-geist-sans,Geist,sans-serif);}.ds-field{display:block;min-height:44px;box-sizing:border-box;width:100%;padding:8px 12px;border:1px solid var(--control-border,#707482);border-radius:8px;background:var(--surface-inset,#111318);color:var(--foreground,#ededf2);font-size:16px;line-height:24px;font-family:var(--font-geist-sans,Geist,sans-serif);transition:background-color 150ms cubic-bezier(0,0,.2,1),color 150ms cubic-bezier(0,0,.2,1),border-color 150ms cubic-bezier(0,0,.2,1);}.ds-field::placeholder{color:var(--muted-foreground,#a5a7b2)}.ds-field:focus-visible{outline:2px solid var(--ring,#a89af3);outline-offset:4px;}.ds-field:disabled{opacity:.6}.ds-field[aria-invalid=true]{border-color:var(--destructive,#ffb4ab)}@media(min-width:768px){.ds-field{font-size:14px;line-height:20px}}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}"
    },
    {
      "name": "Navigation Link",
      "kind": "nav",
