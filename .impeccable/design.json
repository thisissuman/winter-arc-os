      "html": "<nav aria-label=\"Main navigation\"><a class=\"ds-nav-link\" href=\"#today\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 11h18\"/></svg>Today</a></nav>",
      "css": ".ds-nav-link{display:flex;min-height:44px;align-items:center;gap:12px;padding:0 12px;border-radius:8px;color:var(--muted-foreground,#a5a7b2);text-decoration:none;font-size:14px;line-height:20px;font-weight:500;font-family:var(--font-geist-sans,Geist,sans-serif);transition:background-color 150ms cubic-bezier(0,0,.2,1),color 150ms cubic-bezier(0,0,.2,1),border-color 150ms cubic-bezier(0,0,.2,1);}.ds-nav-link[aria-current=page]{background:var(--selected,#28243b);color:var(--selected-foreground,#ededf2)}.ds-nav-link:hover{background:var(--secondary,#22242c);color:var(--foreground,#ededf2)}.ds-nav-link:focus-visible{outline:2px solid var(--ring,#a89af3);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none}}"
    },
    {
      "name": "Schedule Choice",
      "kind": "chip",
      "description": "A native radio in a generous selected-day choice; selection is conveyed by the input and outline.",
      "html": "<label class=\"ds-schedule-choice\"><input type=\"radio\" name=\"ds-schedule\" checked>Daily</label>",
      "css": ".ds-schedule-choice{display:inline-flex;min-height:44px;align-items:center;gap:8px;padding:0 16px;border:1px solid var(--control-border,#707482);border-radius:8px;color:var(--foreground,#ededf2);font-size:14px;line-height:20px;cursor:pointer;font-family:var(--font-geist-sans,Geist,sans-serif);}.ds-schedule-choice:has(input:checked){background:var(--selected,#28243b);border-color:var(--primary,#a89af3)}.ds-schedule-choice:has(input:focus-visible){outline:2px solid var(--ring,#a89af3);outline-offset:4px;}.ds-schedule-choice:hover{border-color:var(--primary,#a89af3)}"
    },
    {
      "name": "Calendar Container",
      "kind": "card",
      "refersTo": "calendar-container",
      "description": "A framed tonal calendar with symbolic date states and primary date selection.",
      "html": "<div class=\"ds-calendar\"><div class=\"ds-calendar-grid\"><a class=\"ds-calendar-date ds-calendar-completed\" href=\"#date-1\" aria-label=\"2026-10-01: completed\">1<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></a><a class=\"ds-calendar-date ds-calendar-selected\" href=\"#date-2\" aria-current=\"date\" aria-label=\"2026-10-02: not completed\">2<span aria-hidden=\"true\">×</span></a><a class=\"ds-calendar-date\" href=\"#date-3\" aria-label=\"2026-10-03: pending today\">3<span aria-hidden=\"true\">○</span></a></div></div>",
      "css": ".ds-calendar{padding:8px;border:1px solid var(--border,#2b2d36);border-radius:16px;background:var(--card,#181a20);font-family:var(--font-geist-sans,Geist,sans-serif);}.ds-calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}.ds-calendar-date{display:flex;min-height:56px;box-sizing:border-box;flex-direction:column;align-items:center;justify-content:center;gap:4px;border:1px solid var(--border,#2b2d36);border-radius:8px;font-size:14px;line-height:20px;text-decoration:none;color:var(--foreground,#ededf2)}.ds-calendar-date:hover{background:var(--secondary,#22242c)}.ds-calendar-date:focus-visible{outline:2px solid var(--ring,#a89af3);outline-offset:4px;}.ds-calendar-selected{border-color:var(--primary,#a89af3);background:var(--selected,#28243b)}@media(min-width:640px){.ds-calendar{padding:16px}.ds-calendar-grid{gap:8px}} .ds-calendar-completed{color:var(--success,#87d5a4)}"
    },
    {
      "name": "Completion Row",
      "kind": "custom",
      "refersTo": "completion-row",
      "description": "One accessible full-row checkbox, readable name and confirmed non-color check.",
      "html": "<div class=\"ds-completion-divider\"><button class=\"ds-completion\" type=\"button\" role=\"checkbox\" aria-checked=\"true\" aria-label=\"Read on 2026-10-03\"><span class=\"ds-completion-mark\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><span class=\"ds-completion-name\">Read</span></button></div>",
      "css": ".ds-completion-divider{border-bottom:1px solid var(--border,#2b2d36)}.ds-completion{display:flex;width:100%;min-height:64px;align-items:center;gap:16px;padding:16px 8px;border:0;border-radius:8px;background:transparent;color:var(--foreground,#ededf2);text-align:left;font-size:16px;line-height:24px;cursor:pointer;font-family:var(--font-geist-sans,Geist,sans-serif);transition:background-color 150ms cubic-bezier(0,0,.2,1),color 150ms cubic-bezier(0,0,.2,1),border-color 150ms cubic-bezier(0,0,.2,1);}.ds-completion:hover{background:var(--secondary,#22242c)}.ds-completion:focus-visible{outline:2px solid var(--ring,#a89af3);outline-offset:4px;}.ds-completion-mark{display:flex;width:36px;height:36px;box-sizing:border-box;flex-shrink:0;align-items:center;justify-content:center;border:2px solid var(--control-border,#707482);border-radius:50%}.ds-completion-name{min-width:0;overflow-wrap:anywhere}.ds-completion[aria-checked=true]{color:var(--muted-foreground,#a5a7b2)}.ds-completion[aria-checked=true] .ds-completion-mark{border-color:var(--success,#87d5a4);background:var(--success,#87d5a4);color:var(--background,#101115)}.ds-completion:disabled{opacity:.7;cursor:default}@media(prefers-reduced-motion:reduce){.ds-completion{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "A quiet daily checklist",
    "overview": "Winter Arc OS is a private habit app designed to be used in under a minute. The approved charcoal/violet world gives ordinary routines a calm, readable setting: familiar controls, short labels, open space and prominent habit names. The identity is Winter Arc OS, with its existing snowflake mark and locally packaged Geist type.\n\nThis document records the implemented replacement, grounded in [the stylesheet](src/app/globals.css), [shared controls](src/components/ui), and Today/Habits/Settings. The five [desktop/phone boards](docs/DESIGN_REVIEW.md) were approved October 3, 2026; they are direction references rather than synchronized user data. The earlier broad-product concepts are superseded. The final real-auth desktop/mobile suite passed all 26 checks; hosted rollback-only security checks also passed. Detailed evidence and remaining actual-device, screen-reader and SMTP limitations belong to [QA](docs/QA.md). This design record does not claim those manual or email checks.",
    "keyCharacteristics": [
      "Solid charcoal and cool paper surfaces with a restrained violet accent.",
      "Narrow task columns, divider rows and a three-destination shell.",
      "Readable completed states, visible focus and large touch controls.",
      "A name-and-schedule editor with quiet, literal save feedback.",
      "Complete dark/light roles, without ornamental gradients, neon, glass or decorative imagery."
    ],
    "rules": [
      {
        "name": "The Meaningful Accent Rule",
        "body": "Use violet for an available action, selection or focus. Keep ordinary rows and section backgrounds neutral.",
        "section": "colors"
      },
      {
        "name": "The Literal Label Rule",
        "body": "Use sentence case and the name of the action or state. Keep visible labels and full accessible names; abbreviated weekdays still announce their full names.",
        "section": "typography"
      },
      {
        "name": "The Task Column Rule",
        "body": "Preserve the readable centered column and let controls wrap on small screens. Extra screen width is breathing room, not a reason to add dashboard panels.",
        "section": "layout"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep ordinary routine rows and Settings sections unraised. Use floating depth for content that overlays the workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use semantic theme roles, visible control strokes and consistent focus treatment.",
      "**Do** keep habit names prominent, wrapping long content and preserving readable completed text.",
      "**Do** keep touch targets large and reserve space for the phone dock and keyboard.",
      "**Do** convey states with symbols or text as well as color.",
      "**Do** mask habit names consistently in Privacy Mode, including editors and accessible labels.",
      "**Do** use literal pending/error feedback and honor reduced motion."
    ],
    "donts": [
      "**Don't** add ornamental gradients, neon, glass, decorative imagery or an animation library.",
      "**Don't** turn Today into score cards, charts, streak rewards or a reporting dashboard.",
      "**Don't** add navigation destinations or required setup fields beyond the accepted product.",
      "**Don't** treat illustrative board labels/counts as saved user data or QA evidence.",
      "**Don't** weaken a readable control or hide its failure state to make a screenshot cleaner."
    ]
  }
}
