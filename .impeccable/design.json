      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:44px;box-sizing:border-box;padding:0 12px;gap:8px;border:1px solid transparent;border-radius:8px;font-size:14px;line-height:21px;font-weight:500;cursor:pointer;font-family:var(--font-geist-sans,Geist,sans-serif);transition:background-color 150ms cubic-bezier(0,0,.2,1),color 150ms cubic-bezier(0,0,.2,1),border-color 150ms cubic-bezier(0,0,.2,1);background:transparent;color:var(--primary,#a89af3);}.ds-button-ghost:hover{background:var(--secondary,#22242c);}.ds-button-ghost:focus-visible{border-color:var(--ring,#a89af3);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring,#a89af3) 50%,transparent);outline:none;}.ds-button-ghost:active{transform:translateY(1px)}.ds-button-ghost:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none}}"
    },
